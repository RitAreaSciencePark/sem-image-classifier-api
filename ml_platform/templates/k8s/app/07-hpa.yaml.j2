# HPA for BentoML based on CPU utilization (queue workers; one inference thread per pod).

{% if autoscaling.enabled %}
apiVersion: autoscaling/v2
kind: HorizontalPodAutoscaler
metadata:
  name: bentoml-hpa
  namespace: {{ namespace }}
  labels:
    app.kubernetes.io/name: bentoml
    app.kubernetes.io/component: autoscaling
spec:
  scaleTargetRef:
    apiVersion: apps/v1
    kind: Deployment
    name: bentoml
  minReplicas: {{ autoscaling.min_replicas }}
  maxReplicas: {{ autoscaling.max_replicas }}
  metrics:
    - type: Resource
      resource:
        name: cpu
        target:
          type: Utilization
          averageUtilization: {{ autoscaling.cpu_target_percent }}
  behavior:
    scaleUp:
      stabilizationWindowSeconds: {{ autoscaling.scale_up_stabilization_seconds }}
      policies:
        - type: Pods
          value: {{ autoscaling.scale_up_pods_per_period }}
          periodSeconds: {{ autoscaling.scale_up_period_seconds }}
      selectPolicy: Max
    scaleDown:
      stabilizationWindowSeconds: {{ autoscaling.scale_down_stabilization_seconds }}
      policies:
        - type: Pods
          value: {{ autoscaling.scale_down_pods_per_period }}
          periodSeconds: {{ autoscaling.scale_down_period_seconds }}
{% endif %}
