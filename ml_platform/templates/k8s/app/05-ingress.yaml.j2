# Production public route for the KrakenD API gateway.
# Not applied by ./app.sh deploy — production operators apply manually
# (same pattern as s3bucket 04-ingress.yaml).
#
# Replace the host with your production hostname before applying.
---
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: {{ namespace }}.areasciencepark.it
  namespace: {{ namespace }}
  labels:
    app.kubernetes.io/name: api-gateway
    app.kubernetes.io/component: ingress
spec:
  ingressClassName: haproxy-4
  rules:
    - host: {{ namespace }}.areasciencepark.it
      http:
        paths:
          - path: /
            pathType: Prefix
            backend:
              service:
                name: krakend
                port:
                  number: 8080

