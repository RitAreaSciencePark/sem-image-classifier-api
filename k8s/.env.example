# GitHub Container Registry credentials — copy to .env and fill in the real token.
# .env is gitignored; .env.example is committed as a reference.
#
# | Variable    | Who needs it              | How to create |
# |-------------|---------------------------|---------------|
# | GHCR_TOKEN  | Deployment host (push)    | Classic PAT at https://github.com/settings/tokens/new?scopes=write:packages |
#
# Required scope: write:packages (includes read:packages automatically)
#
# Usage:
#   cp k8s/.env.example k8s/.env
#   chmod 600 k8s/.env
#   # Edit GHCR_TOKEN, then: make deploy SERVICE=sem-classifier DEPLOY_ARGS=--rebuild
#
# K3s pulls images from public GHCR packages — no imagePullSecrets needed after
# you set each package to Public on GitHub (first push creates the package).
GHCR_TOKEN="ghp_replace_with_your_token"
